# Credenciais do Supabase, usadas por src/app/api/config/route.ts
# para alimentar a sincronização de tarefas, clientes e avaliações.
# SUPABASE_KEY é a publishable key (exposta ao navegador, só leitura via RLS).
SUPABASE_URL=
SUPABASE_KEY=

# Secret key (sb_secret_...) — server-side, bypassa RLS. Usada SÓ pelas rotas
# de escrita da área de missões (/api/missoes). Nunca exponha no client.
SUPABASE_SECRET_KEY=

# Senha da área de missões (/missoes). Exigida só para adicionar/mover/remover
# missões — ver a lista é público. Server-side (sem NEXT_PUBLIC_). Se vazia, o
# gerenciamento fica desativado.
MISSOES_PASSWORD=
