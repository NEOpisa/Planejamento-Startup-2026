# Credenciais do Supabase, usadas por src/app/api/config/route.ts
# para alimentar a sincronização de tarefas, clientes e avaliações.
# SUPABASE_KEY deve ser a publishable key (sb_publishable_...), pois é
# exposta ao navegador via /api/config (respeita o RLS).
SUPABASE_URL=
SUPABASE_KEY=

# Secret key (sb_secret_...) — usada SOMENTE no servidor por
# src/app/api/clientes/[id]/route.ts para excluir clientes (bypassa RLS).
# Nunca é enviada ao navegador. Pegue em Project Settings → API Keys.
SUPABASE_SECRET_KEY=
