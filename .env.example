# Credenciais de um servidor TURN real. Consulte o README antes de publicar.
# Configure no ambiente da hospedagem ou em .env.local (não versionado).
# TURN_URL=turn:turn.seu-dominio.com:3478,turns:turn.seu-dominio.com:443?transport=tcp
# TURN_USER=usuario-fornecido-pelo-servico
# TURN_SENHA=senha-fornecida-pelo-servico

# Sinalização pelo Supabase Realtime, já suportada pelo projeto.
# Na Vercel, defina antes do build e faça um novo deploy.
# Use apenas a chave publicável/anon, nunca service_role nesta variável.
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=chave-publicavel-do-projeto
