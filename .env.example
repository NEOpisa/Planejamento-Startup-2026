# Credenciais do Supabase, usadas por src/app/api/config/route.ts
# para alimentar a sincronização de tarefas, clientes e avaliações.
# SUPABASE_KEY é a publishable key (exposta ao navegador, só leitura via RLS).
SUPABASE_URL=
SUPABASE_KEY=

# Secret key (sb_secret_...) — server-side, bypassa RLS. Usada SÓ pelas rotas
# de escrita da área de missões (/api/missoes). Nunca exponha no client.
SUPABASE_SECRET_KEY=

# Senha-mestra das MISSÕES DA EMPRESA (/missoes). Só você tem. Exigida para
# CRIAR / ATRIBUIR / REMOVER missões da empresa (server-side, sem NEXT_PUBLIC_).
# Se vazia, a criação de missões da empresa fica desativada.
#
# Obs.: o LOGIN dos membros (e a área "Minhas missões") usa Supabase Auth e
# reaproveita SUPABASE_URL + SUPABASE_KEY acima — não precisa de env extra.
MISSOES_PASSWORD=
