# Credenciais do Supabase (server) — usadas por src/app/api/config/route.ts
# (sincronização de tarefas, clientes e avaliações) e pelo /api/clientes (delete).
SUPABASE_URL=
SUPABASE_KEY=
# Secret key (server-side) usada para excluir cliente. Não expor no client.
SUPABASE_SECRET_KEY=

# Supabase Auth (login/cadastro dos vendedores na área de Clientes).
# Expostas ao navegador (NEXT_PUBLIC_): URL do projeto + publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
